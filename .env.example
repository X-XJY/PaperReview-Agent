# Copy to .env. Never commit credentials. API keys are used only by the server.
MINERU_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# Fill the model identifier available in your provider account.
LLM_MODEL=
LLM_JSON_SCHEMA=false
DATA_DIR=./data
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_BATCH_FILES=8
MAX_FILE_MB=30
MAX_PDF_PAGES=50
DAILY_PAPER_LIMIT=40
LLM_MAX_CALLS_PER_JOB=100
MINERU_TIMEOUT_SECONDS=900
SESSION_TTL_DAYS=7
